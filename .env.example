# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ADMIN_TOKEN=change-me

# --- Database (local/docker) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=agente
POSTGRES_PASSWORD=agente
POSTGRES_DB=agente
DATABASE_URL=postgresql+psycopg2://agente:agente@db:5432/agente

# --- Retrieval ---
SIMILARITY_THRESHOLD=0.78
TOP_K=5
DOCS_PATH=./data/docs

# --- LLM ---
# none | groq | vertex | openai | huggingface
LLM_PROVIDER=none
GROQ_API_KEY=
OPENAI_API_KEY=

# --- GCP / Vertex ---
GCP_PROJECT=
GCP_REGION=us-central1
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
VERTEX_EMBEDDING_MODEL=text-embedding-004

# Vector Search (opcional; se vazio, usa pgvector)
VS_INDEX_ID=
VS_ENDPOINT_ID=
VS_DEPLOYED_INDEX_ID=

# BigQuery (analytics)
BQ_DATASET=agente_analytics
BQ_TABLE_INTERACTIONS=interactions
BQ_TABLE_FEEDBACK=feedback

# Cloud SQL (produção Cloud Run)
CLOUD_SQL_CONNECTION_NAME=

# --- Frontend ---
VITE_API_URL=/api
